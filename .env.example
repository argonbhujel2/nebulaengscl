# Flask
SECRET_KEY=change-this-to-a-long-random-secret-key
FLASK_ENV=production
FLASK_APP=app.py

# Database — local SQLite (leave empty or use sqlite)
# DATABASE_URL=sqlite:///school.db

# PostgreSQL (Neon / Supabase / Railway / Vercel Postgres / Layerbase)
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/school_db

# Upload size limit (5 MB)
MAX_CONTENT_LENGTH=5242880

# Cloudinary (optional — images go to cloud when set)
# Get free account: https://cloudinary.com
# Either set CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or set separately:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_ALL=1
